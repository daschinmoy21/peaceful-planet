---
import Layout from "../layouts/Layout.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import { fetchGitHubActivity } from "@/utils/github";

const activity = await fetchGitHubActivity().catch((err) => {
  console.error("[github] failed to fetch activity for /oss:", err);
  return {
    contributions: [],
    weeks: [],
    monthLabels: [],
    total: 0,
    year: null,
    prs: [],
    repositories: [],
  };
});
---

<Layout>
  <div class="py-6">
    <GitHubActivity activity={activity} />
  </div>
</Layout>
