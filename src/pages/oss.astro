---
import Layout from "../layouts/Layout.astro";
import OpenSource from "../components/OpenSource.astro";
import { fetchGitHubPRs } from "@/utils/github";

const prs = await fetchGitHubPRs().catch((err) => {
  console.error("[oss] failed to fetch PRs for /oss:", err);
  return [];
});
---

<Layout>
  <div class="py-6">
    <OpenSource prs={prs} graphPosition="top" />
  </div>
</Layout>
