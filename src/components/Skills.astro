---
const groups = [
  { key: "languages", items: "Rust, Go, TypeScript, C++, Python, JavaScript" },
  { key: "tech", items: "Docker, Docker Compose, Nix, Terraform, CI/CD, Linux, Git, WebRTC, FFmpeg" },
  { key: "databases", items: "PostgreSQL, MongoDB" },
];
---

<div class="site-section animate-fade-in-up" data-reveal>
  <div class="section-heading-row">
    <h2 class="section-heading">Skills</h2>
  </div>

  <div class="flex flex-col gap-2 font-mono text-sm">
    {groups.map((group) => (
      <div class="flex items-baseline gap-2.5">
        <span class="w-24 shrink-0 text-zinc-200">{group.key}</span>
        <span class="text-zinc-400 leading-relaxed">{group.items}</span>
      </div>
    ))}
  </div>
</div>
