---
const experiences = [
  {
    company: "Freelance",
    role: "Contract Developer",
    period: "2025 - Present",
    description: [
      "Designed, developed, and deployed a high-performance website for a non-governmental organization (NGO) using Astro and TypeScript",
      "Optimized build pipeline and static site generation, achieving 100/100 Lighthouse performance and accessibility scores",
      "Set up streamlined content editing workflows and integrated hosting, enabling non-technical staff to easily publish updates"
    ],
  },
];
---

<div class="site-section" data-reveal>
  <div class="section-heading-row">
    <h2 class="section-heading">Experience</h2>
  </div>

  <div class="flex flex-col gap-6">
    {experiences.map((exp) => (
      <div class="flex flex-col gap-2 animate-fade-in-up">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
            <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 font-sans lowercase">
              {exp.role}
            </h3>
            <span class="text-xs font-mono text-zinc-500 lowercase">{exp.company}</span>
          </div>
          <span class="text-xs font-mono tone-ok shrink-0 lowercase">{exp.period}</span>
        </div>

        <ul class="flex flex-col gap-1.5 font-mono text-xs text-zinc-400 mt-1">
          {exp.description.map((item) => (
            <li class="flex items-baseline gap-2.5 leading-relaxed">
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
