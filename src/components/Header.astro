---
const rows = [
  { key: "role", value: "systems & backend developer", meta: "he/him" },
  { key: "based", value: "assam, india", clock: true },
  { key: "study", value: "4th year cs ug" },
];
---

<div class="pt-0 pb-2 animate-fade-in-up">
  <div class="flex flex-col gap-5">
    <!-- Animated banner -->
    <div class="relative w-full h-44 sm:h-52 border border-zinc-800 overflow-hidden">
      <img
        src="/banner-kirby.gif"
        alt="Animated Kirby banner"
        class="absolute inset-0 w-full h-full object-cover object-[32%_center]"
        style="image-rendering: pixelated"
      />
      <!-- Soft gradient so text stays readable -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent"></div>
      <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 flex items-center gap-3.5">
        <h1 class="banner-title text-4xl font-semibold tracking-tight font-sans lowercase drop-shadow-md">chinmoy</h1>
        <img
          src="/buttons/self.png"
          width="88"
          height="31"
          alt="Self button"
          class="border border-zinc-900"
        />
      </div>
    </div>

    <div class="flex flex-col gap-1.5 font-mono text-sm">
      {rows.map((row) => (
        <div class="flex items-baseline gap-2.5">
          <span class="w-14 shrink-0 text-zinc-500">{row.key}</span>
          <span class="text-zinc-200">
            {row.value}
            {row.meta && <span class="ml-1.5 text-zinc-500">{row.meta}</span>}
            {row.clock && <span id="header-clock" class="ml-1.5 text-zinc-500 tabular-nums"></span>}
          </span>
        </div>
      ))}
    </div>

    <!-- Short Bio -->
    <p class="text-sm leading-relaxed font-sans">
      I enjoy building high-performance systems and backend tools. Currently exploring virtual machine orchestration and distributed systems. Writing Rust, Go, and TypeScript.
    </p>
  </div>
</div>

<script>
  // Clock update
  const clock = document.getElementById("header-clock")!;
  const updateClock = () => {
    clock.textContent = new Date().toLocaleTimeString("en-US", {
      timeZone: "Asia/Kolkata",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }) + " ist";
  };
  updateClock();
  setInterval(updateClock, 1000);
</script>
