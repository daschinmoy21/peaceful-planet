---
---
<footer class="py-6 mt-8 border-t border-zinc-900 flex flex-col gap-5">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 label">
    <span>press 1-4 to switch views</span>
    <span>© {new Date().getFullYear()} chinmoy</span>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <img 
      src="/buttons/nixos.gif" 
      width="88" 
      height="31" 
      alt="NixOS" 
      loading="lazy"
      decoding="async"
      class="opacity-90 hover:opacity-100 transition-opacity border border-zinc-900" 
      title="NixOS"
    />
    <img 
      src="/buttons/miku.gif" 
      width="88" 
      height="31" 
      alt="Hatsune Miku" 
      loading="lazy"
      decoding="async"
      class="opacity-90 hover:opacity-100 transition-opacity border border-zinc-900" 
      title="Hatsune Miku"
    />
 
    <img 
      src="/buttons/kawaiibutton.gif" 
      width="88" 
      height="31" 
      alt="Kawaii Button" 
      loading="lazy"
      decoding="async"
      class="opacity-90 hover:opacity-100 transition-opacity border border-zinc-900" 
      title="Kawaii Button"
    />
    <img 
      src="/buttons/pikachu.gif" 
      width="88" 
      height="31" 
      alt="Pikachu" 
      loading="lazy"
      decoding="async"
      class="opacity-90 hover:opacity-100 transition-opacity border border-zinc-900" 
      title="Pikachu"
    />
    <img 
      src="/buttons/fingerofgod.gif" 
      width="88" 
      height="31" 
      alt="Finger of God" 
      loading="lazy"
      decoding="async"
      class="opacity-90 hover:opacity-100 transition-opacity border border-zinc-900" 
      title="Finger of God"
    />
  </div>
</footer>
