---
const links = [
  { key: "github", label: "github.com/daschinmoy21", href: "https://github.com/daschinmoy21", external: true },
  { key: "x", label: "x.com/crimxnhaze", href: "https://x.com/crimxnhaze", external: true },
  { key: "email", label: "daschinmoyy21@gmail.com", href: "mailto:daschinmoyy21@gmail.com" },
];
---

<div class="site-section" data-reveal>
  <div class="section-heading-row">
    <h2 class="section-heading">Contact</h2>
  </div>

  <div class="flex flex-col gap-4">
    <p class="text-sm text-zinc-400 font-sans leading-relaxed">
      I'm always open to new opportunities, systems talk, or feedback. Feel free to reach out.
    </p>

    <div class="flex flex-col gap-1.5 font-mono text-sm">
      {links.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          class="w-fit flex items-baseline gap-2.5 group"
        >
          <span class="w-14 shrink-0 text-zinc-500">{link.key}</span>
          <span class="text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-white transition-colors duration-200">{link.label}</span>
        </a>
      ))}
    </div>
  </div>
</div>
